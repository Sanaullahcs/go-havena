{
  "name": "havena-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Havena web portal — admin & resident dashboards in one Next.js app",
  "scripts": {
    "dev": "npm run firebase:sw && NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack -p 3000 -H 0.0.0.0",
    "dev:turbopack": "NODE_OPTIONS='--max-old-space-size=8192' next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:stable": "npm run build && NODE_OPTIONS='--max-old-space-size=4096' next start -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "firebase:sw": "node scripts/generate-firebase-sw.mjs",
    "test:validation": "tsx scripts/test-form-validation.ts"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "firebase": "^12.16.0",
    "libphonenumber-js": "^1.13.7",
    "lucide-react": "^1.23.0",
    "go-havena": "file:..",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}
