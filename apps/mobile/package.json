{
  "name": "havena-app",
  "main": "index.js",
  "version": "1.0.4",
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-go-manifest.cjs && node ./scripts/patch-expo-go-reload.cjs",
    "start": "node ./scripts/start-with-go-identity.cjs start --lan",
    "start:clear": "node ./scripts/start-with-go-identity.cjs start --lan --clear",
    "test:updates-identity": "node ./scripts/test-expo-go-manifest-identity.mjs",
    "test:resident-mode": "node ./scripts/test-resident-mode-switch.mjs",
    "start:lan": "powershell -ExecutionPolicy Bypass -File ./start-expo-lan.ps1",
    "check:lan": "powershell -ExecutionPolicy Bypass -File ./check-lan.ps1",
    "start:hotspot": "powershell -ExecutionPolicy Bypass -File ./connect-phone-hotspot.ps1",
    "start:pc-hotspot": "powershell -ExecutionPolicy Bypass -File ./start-pc-hotspot.ps1",
    "start:web": "expo start --web --clear",
    "start:tunnel": "expo start --tunnel ngrok --clear",
    "start:android-go": "bash ./start-expo-android.sh",
    "start:dev": "powershell -ExecutionPolicy Bypass -File ./start-mobile-dev.ps1",
    "android": "expo run:android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./start-local-backend.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "lint": "expo lint",
    "test:validation": "node scripts/test-form-validation.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "app-locale": "file:./modules/app-locale",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-media-library": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.1.0",
    "i18next": "^26.3.6",
    "libphonenumber-js": "^1.13.7",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "^3.4.17"
  },
  "private": true
}
