{
  "name": "neighborhub-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --lan --clear",
    "start:clear": "expo start --lan --clear",
    "start:lan": "powershell -ExecutionPolicy Bypass -File ./start-expo-lan.ps1",
