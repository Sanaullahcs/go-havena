{
  "name": "havena-app",
  "main": "index.js",
  "version": "1.0.4",
  "scripts": {
    "postinstall": "node ./scripts/patch-expo-go-manifest.cjs",
    "start": "node ./scripts/start-with-go-identity.cjs start --lan",
    "start:clear": "node ./scripts/start-with-go-identity.cjs start --lan --clear",
    "test:updates-identity": "node ./scripts/test-expo-go-manifest-identity.mjs",
    "test:resident-mode": "node ./scripts/test-resident-mode-switch.mjs",
    "start:lan": "powershell -ExecutionPolicy Bypass -File ./start-expo-lan.ps1",
    "check:lan": "powershell -ExecutionPolicy Bypass -File ./check-lan.ps1",
    "start:hotspot": "powershell -ExecutionPolicy Bypass -File ./connect-phone-hotspot.ps1",
    "start:pc-hotspot": "powershell -ExecutionPolicy Bypass -File ./start-pc-hotspot.ps1",
    "start:web": "expo start --web --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "start:android-go": "bash ./start-expo-android.sh",
    "start:dev": "powershell -ExecutionPolicy Bypass -File ./start-mobile-dev.ps1",
    "android": "expo run:android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File ./build-apk.ps1",
    "start:local": "powershell -ExecutionPolicy Bypass -File ./start-local-backend.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "lint": "expo lint",
    "test:validation": "node scripts/test-form-validation.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "app-locale": "file:./modules/app-locale",
    "expo": "^57.0.23",
    "expo-asset": "~57.0.17",
    "expo-build-properties": "~57.0.20",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
