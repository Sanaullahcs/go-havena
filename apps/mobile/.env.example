# Point mobile app at your Laravel API (optional — auto-detects Metro LAN IP on port 8000)
# Physical device on same Wi-Fi (refreshed by npm run start:lan):
# EXPO_PUBLIC_API_URL=http://192.168.0.134:8000/api/v1
# EXPO_PUBLIC_ADMIN_URL=http://192.168.0.134:3000
# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#
# Backend must listen on all interfaces: php artisan serve --host=0.0.0.0 --port=8000
# Expo on LAN: npm run start:lan   (from apps/mobile)
# One-time firewall (Admin PowerShell): powershell -ExecutionPolicy Bypass -File .\setup-firewall.ps1

# Local dev test login (OTP always 123456 in local env):
#   Resident (opens Home):        (555) 555-0100  / +15555550100
#   Community admin (opens Home): (555) 555-0200  / +15555550200
#   Legacy resident:              (555) 555-5555  / +15555555555
#   Legacy admin:                 (555) 666-8888  / +15556668888
#
# Seed accounts: php artisan db:seed --class=MobileTestAccountsSeeder
# Demo content + pictures: php artisan havena:seed-demo
