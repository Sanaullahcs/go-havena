{
  "expo": {
    "name": "Havena",
    "slug": "havena",
    "owner": "sanas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "havena",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zsquare.havena",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Havena uses Face ID to sign you in quickly and securely.",
        "NSPhotoLibraryUsageDescription": "Allow Havena to save photos from the community feed to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow Havena to save photos from the community feed to your gallery.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleLocalizations": [
          "en",
          "es",
          "ar"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4F8A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.zsquare.havena"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Havena to choose a profile photo from your library.",
          "cameraPermission": "Allow Havena to take a profile photo with your camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Havena to save photos from the community feed to your gallery.",
          "savePhotosPermission": "Allow Havena to save photos from the community feed to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Havena to scan invite QR codes and take photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Havena to sign you in with Face ID."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "ar"
            ],
            "android": [
              "en",
              "es",
              "ar"
            ]
          }
        }
      ],
      "./plugins/with-app-locale.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark"
      },
      "expo-navigation-bar": {
        "style": "dark"
      },
      "eas": {
        "projectId": "23aaa527-0ab0-49ab-9f93-1aaa427e1b99"
      }
    }
  }
}
