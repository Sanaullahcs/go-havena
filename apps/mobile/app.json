{
  "expo": {
    "name": "Havena",
    "slug": "havena",
    "owner": "sanas-team",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "havena",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/23aaa527-0ab0-49ab-9f93-1aaa427e1b99"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zsquare.havena",
      "buildNumber": "44",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Havena uses Face ID to sign you in quickly and securely.",
        "NSCameraUsageDescription": "Havena uses the camera to scan invite QR codes and take photos for your profile, feed, or payment receipts.",
        "NSPhotoLibraryUsageDescription": "Allow Havena to choose a photo from your library for your profile, feed, or payment receipts.",
        "NSPhotoLibraryAddUsageDescription": "Allow Havena to save photos from the community feed to your gallery.",
        "NSUserNotificationsUsageDescription": "Havena sends notifications about notices, messages, and community activity.",
        "NSLocationWhenInUseUsageDescription": "Havena uses your location to show distance and travel time for community listings.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "es",
          "ar"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.zsquare.havena",
      "googleServicesFile": "./google-services.json",
      "versionCode": 25
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Havena to choose a photo from your library for your profile, feed, or payment receipts.",
          "cameraPermission": "Allow Havena to take a photo for your profile, feed, or payment receipts."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Havena to save photos from the community feed to your gallery.",
          "savePhotosPermission": "Allow Havena to save photos from the community feed to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Havena to scan invite QR codes and take photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Havena to sign you in with Face ID."
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Havena to use your location to show distance and travel time."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "ar"
            ],
            "android": [
              "en",
              "es",
              "ar"
            ]
          }
        }
      ],
      "./plugins/with-app-locale.js",
      [
        "expo-notifications",
        {
          "color": "#1B4F8A",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class expo.modules.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark"
      },
      "expo-navigation-bar": {
        "style": "dark"
      },
      "eas": {
        "projectId": "23aaa527-0ab0-49ab-9f93-1aaa427e1b99"
      }
    }
  }
}
