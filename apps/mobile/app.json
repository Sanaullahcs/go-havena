{
  "expo": {
    "name": "Havena",
    "slug": "neighborlink",
    "owner": "sanas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "neighborlink",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zsquare.neighborlink",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Havena uses Face ID to sign you in quickly and securely.",
        "NSPhotoLibraryUsageDescription": "Allow Havena to save photos from the community feed to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow Havena to save photos from the community feed to your gallery.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0052DF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.neighborlink.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0052DF",
          "dark": {
            "backgroundColor": "#0052DF"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Havena to choose a profile photo from your library.",
          "cameraPermission": "Allow Havena to take a profile photo with your camera."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Havena to save photos from the community feed to your gallery.",
          "savePhotosPermission": "Allow Havena to save photos from the community feed to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Havena to scan invite QR codes and take photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Havena to sign you in with Face ID."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark"
      },
      "expo-navigation-bar": {
        "style": "dark"
      },
      "eas": {
        "projectId": "4f72474d-95e8-4afb-b44d-7c80cd4bb03d"
      }
    }
  }
}
