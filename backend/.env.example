APP_DEBUG=true
APP_TIMEZONE=UTC
APP_SCHEDULE_TIMEZONE=UTC
APP_URL=http://localhost:8000

FRONTEND_ADMIN_URL=http://localhost:3000
FRONTEND_USER_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=go_havena
DB_USERNAME=root
