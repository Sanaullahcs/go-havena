APP_NAME=Havena
APP_ENV=local
APP_KEY=base64:K2apwTGB57bv/eLiCDFPecnAB8CgM70ahmkdGetP0+E=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_SCHEDULE_TIMEZONE=UTC
APP_URL=http://localhost:8000
# Public API URL for hosted email images (invite QR). Use your production API host in staging/prod.
# Public HTTPS API base for hosted email images (invite QR). Required in production.
# When unset, Havena SMTP/from address auto-defaults to https://api.gohavena.com.
# API_PUBLIC_URL=https://api.gohavena.com

FRONTEND_ADMIN_URL=http://localhost:3000
FRONTEND_USER_URL=http://localhost:3000
HAVENA_APP_STORE_URL=https://apps.apple.com/app/id6800697897
HAVENA_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.zsquare.havena
HAVENA_TAGLINE="One trusted place for the whole neighborhood."
# Optional CDN/public URL for the logo in emails. Defaults to APP_URL/images/email/havena-mark.png
# HAVENA_LOGO_URL=
# HAVENA_WEBSITE_URL=https://gohavena.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=go_havena
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_PREFIX=nbr_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "log" locally when SMTP is unreachable so OTP login is not blocked.
# Use smtp with this environment's own host and password. "log" records mail locally and does not deliver invitations.
MAIL_MAILER=smtp
MAIL_HOST=mail.gohavena.com
MAIL_PORT=587
MAIL_USERNAME=hello@gohavena.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@gohavena.com"
MAIL_FROM_NAME="${APP_NAME}"
# OTP_REQUIRE_MAIL=true forces OTP_MAIL_FAILED when mail cannot be delivered (default: production only)

# Inbox that receives demo / contact form notifications
MAIL_CONTACT_TO=hello@gohavena.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (web push + optional native)
# Download service account JSON from Firebase Console → Project settings → Service accounts.
FIREBASE_CREDENTIALS=storage/firebase-service-account.json

# Community subscription billing (use Stripe TEST mode keys for local/dev)
# Dashboard → toggle Test mode / Sandbox → Developers → API keys (pk_test_ / sk_test_)
# Setup: php artisan billing:setup-stripe --key=pk_test_... --secret=sk_test_... --write-env
# STRIPE_AUTO_PROVISION_PRICES=true creates missing price IDs on first checkout (default).
# Docs: backend/docs/BILLING-STRIPE-TEST.md
BILLING_ENABLED=true
BILLING_ENFORCE_SEATS=true
# stripe = card checkout + trial. Self-serve never starts a trial without a card.
# System admins can still grant a plan from Billing (no card).
BILLING_DRIVER=stripe
BILLING_TRIAL_PERIOD_DAYS=30
BILLING_GRACE_DAYS=7
BILLING_CURRENCY=usd
STRIPE_CHECKOUT_LOCALE=en
STRIPE_BUSINESS_NAME=Havena
# STRIPE_CHECKOUT_PMC_ID=pmc_...  # optional card-only payment method configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_CAMPUS_MONTHLY=
STRIPE_PRICE_CAMPUS_YEARLY=
STRIPE_PRICE_SEAT_PACK_MONTHLY=
# BILLING_CHECKOUT_SUCCESS_URL=
# BILLING_CHECKOUT_CANCEL_URL=
# BILLING_PORTAL_RETURN_URL=

# Plaid bank linking (Sandbox credentials from Plaid Dashboard → Keys)
# Status: php artisan plaid:status
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_SUPPORTED_COUNTRY_CODES=US
PLAID_TRANSFER_ENABLED=true
# PLAID_TRANSFER_SIMULATE=true
# PLAID_WEBHOOK_URL=https://example.com/api/v1/plaid/webhook
# PLAID_VERIFY_WEBHOOKS=false
# PLAID_CA_BUNDLE=

# Store-review OTP (allowlisted emails only). Demo showcase accounts use 221322
# for resident@gohavena.com and community@gohavena.com in every environment.
# OTP_RATE_LIMIT_ENABLED=true
# OTP_EXPIRE_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_RESENDS=3
# OTP_RESEND_LOCK_SECONDS=900
# OTP_WRONG_VERIFY_LOCK_SECONDS=3600
# OTP_VERIFY_FAIL_THRESHOLD=3
# OTP_VERIFY_FAIL_LOCK_SECONDS=900
# OTP_VERIFY_FAIL_LOCK_SCHEDULE=900,1800,3600
# Shared fallback accepted for every user while their emailed code is still valid.
# OTP_UNIVERSAL_CODE=221322
# OTP_FIXED_CODE=123456
# OTP_FIXED_EMAILS=test.resident@havena.app,test.community.admin@havena.app
# OTP_DEMO_RESIDENT_CODE=221322
# OTP_DEMO_COMMUNITY_CODE=221322
# OTP_DEMO_UMER_CODE=221322
# OTP_DEMO_FALLBACK_EMAILS=umer@namuve.com

# Utility bill / lease upload — heuristic validation + optional Tesseract OCR
# UTILITY_BILL_OCR_ENABLED=true
# TESSERACT_BINARY=tesseract
# TESSERACT_LANG=eng
# PDFTOPPM_BINARY=pdftoppm
# UTILITY_BILL_OCR_TIMEOUT=45
