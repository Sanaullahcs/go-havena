SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_PREFIX=nbr_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging (web push + optional native)
# Download service account JSON from Firebase Console → Project settings → Service accounts.
FIREBASE_CREDENTIALS=storage/firebase-service-account.json

# Community subscription billing (use Stripe TEST mode keys for local/dev)
# Dashboard → toggle Test mode / Sandbox → Developers → API keys (pk_test_ / sk_test_)
# Setup: php artisan billing:setup-stripe --key=pk_test_... --secret=sk_test_... --write-env
# Docs: backend/docs/BILLING-STRIPE-TEST.md
BILLING_ENABLED=true
BILLING_ENFORCE_SEATS=true
# stripe = card checkout + trial. Self-serve never starts a trial without a card.
# System admins can still grant a plan from Billing (no card).
BILLING_DRIVER=stripe
BILLING_TRIAL_PERIOD_DAYS=30
BILLING_GRACE_DAYS=7
BILLING_CURRENCY=usd
STRIPE_CHECKOUT_LOCALE=en
STRIPE_BUSINESS_NAME=Havena
# STRIPE_CHECKOUT_PMC_ID=pmc_...  # optional card-only payment method configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_CAMPUS_MONTHLY=
STRIPE_PRICE_CAMPUS_YEARLY=
STRIPE_PRICE_SEAT_PACK_MONTHLY=
# BILLING_CHECKOUT_SUCCESS_URL=
# BILLING_CHECKOUT_CANCEL_URL=
# BILLING_PORTAL_RETURN_URL=

# Plaid bank linking (Sandbox credentials from Plaid Dashboard → Keys)
# Status: php artisan plaid:status
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
